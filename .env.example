# Copy this file to .env and fill in the values you need.
# .env is read automatically by `docker compose`.

# --- Published port / bind address (Docker) ---
# Open http://<host>:<TAPO_WEB_PORT> after starting the container.
TAPO_WEB_PORT=8080
# Use 0.0.0.0 to reach the UI from other devices on your LAN, or 127.0.0.1
# to restrict it to the Docker host only.
TAPO_WEB_BIND=0.0.0.0

# --- Optional auto-connect (camera) ---
# When TAPO_HOST, TAPO_USER and TAPO_PASS are set, the app connects at startup
# instead of waiting for the Settings dialog. Leave them blank to use the UI.
TAPO_HOST=
TAPO_USER=
TAPO_PASS=
TAPO_PORT=2020
TAPO_STREAM=stream1

# Tapo app account password (not the camera account password), optional.
# Required only for spotlight and day/night controls.
TAPO_CLOUD_PASS=
